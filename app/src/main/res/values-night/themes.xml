<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Application Theme (Night Mode) -->
    <style name="Theme.CardVault" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorPrimaryDark">@color/primary_blue_dark</item>
        <item name="colorAccent">@color/primary_blue_light</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:statusBarColor">@color/card_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/card_surface</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Native Starting Splash Theme (Night Mode) -->
    <style name="Theme.CardVault.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/card_surface</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.CardVault</item>
    </style>
</resources>
