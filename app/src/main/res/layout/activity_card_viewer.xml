<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <!-- Top Action Bar -->
    <LinearLayout
        android:id="@+id/viewerTopBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/card_surface"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:elevation="2dp">

        <ImageView
            android:id="@+id/btnViewerClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_cancel" />

        <TextView
            android:id="@+id/tvViewerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:text="Card Zoom &amp; 3D Flip"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvViewerCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Student ID"
            android:textColor="@color/primary_blue"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_category_chip"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp" />
    </LinearLayout>

    <!-- Center Card Flip Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_below="@id/viewerTopBar"
        android:layout_above="@id/layoutViewerBottomActions"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- 3D Card Container (FrameLayout containing Front & Back faces) -->
        <FrameLayout
            android:id="@+id/cardContainer"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_gravity="center"
            android:clickable="true"
            android:focusable="true">

            <!-- ================= FRONT FACE ================= -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardFrontView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/card_surface">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/ivCardFrontPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:background="@color/soft_blue_surface"
                        android:src="@drawable/ic_card_placeholder"
                        android:contentDescription="Card Front Face" />

                    <!-- Front Face Title Overlay if placeholder -->
                    <TextView
                        android:id="@+id/tvCardFrontName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_alignParentStart="true"
                        android:layout_margin="16dp"
                        android:text="Card Name"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- ================= BACK FACE ================= -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardBackView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#FFFFFF">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_card_back">

                    <!-- Magnetic Stripe -->
                    <View
                        android:id="@+id/stripeMagnetic"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_alignParentTop="true"
                        android:layout_marginTop="16dp"
                        android:background="#1E293B" />

                    <!-- Signature & Identifier Box -->
                    <LinearLayout
                        android:id="@+id/layoutSignatureBox"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_below="@id/stripeMagnetic"
                        android:layout_marginTop="14dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:background="#F1F5F9"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="AUTHORIZED SIGNATURE"
                            android:textColor="#94A3B8"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCardBackIdentifier"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="STU-9482"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Barcode Visual Representation -->
                    <ImageView
                        android:id="@+id/ivCardBackBarcode"
                        android:layout_width="220dp"
                        android:layout_height="34dp"
                        android:layout_below="@id/layoutSignatureBox"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="14dp"
                        android:src="@drawable/ic_barcode"
                        android:scaleType="fitXY"
                        android:contentDescription="Barcode" />

                    <!-- Bottom Metadata & Security Notice -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="12dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvCardBackExpiry"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Exp: 08/27"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CardVault Secured"
                            android:textColor="@color/primary_blue"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </RelativeLayout>
            </androidx.cardview.widget.CardView>

        </FrameLayout>

        <!-- Tap to flip instruction hint -->
        <TextView
            android:id="@+id/tvTapToFlipHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="👆 Tap card anywhere to flip"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Bottom Controls: Flip Actions -->
    <LinearLayout
        android:id="@+id/layoutViewerBottomActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/card_surface"
        android:elevation="4dp"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Flip Horizontal Button -->
        <Button
            android:id="@+id/btnFlipHorizontal"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Flip Horizontal 🔄"
            android:textColor="@color/primary_blue"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_secondary" />

        <!-- Flip Vertical Button -->
        <Button
            android:id="@+id/btnFlipVertical"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Flip Vertical 🔃"
            android:textColor="@color/primary_blue"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_secondary" />

    </LinearLayout>

</RelativeLayout>
