<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottomNavigationContainer"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="horizontal"
    android:background="@color/card_surface"
    android:elevation="8dp"
    android:gravity="center_vertical">

    <!-- Nav Item: Home -->
    <LinearLayout
        android:id="@+id/navItemHome"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_nav_item"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/ivNavHome"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_nav_home"
            android:contentDescription="@string/nav_home" />

        <TextView
            android:id="@+id/tvNavHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_home"
            android:textColor="@color/primary_blue"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginTop="3dp" />
    </LinearLayout>

    <!-- Nav Item: My Cards -->
    <LinearLayout
        android:id="@+id/navItemCards"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_nav_item"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/ivNavCards"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_nav_cards"
            android:contentDescription="@string/nav_cards" />

        <TextView
            android:id="@+id/tvNavCards"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_cards"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:layout_marginTop="3dp" />
    </LinearLayout>

    <!-- Nav Item: Settings -->
    <LinearLayout
        android:id="@+id/navItemSettings"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_nav_item"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/ivNavSettings"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_nav_settings"
            android:contentDescription="@string/nav_settings" />

        <TextView
            android:id="@+id/tvNavSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_settings"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:layout_marginTop="3dp" />
    </LinearLayout>

</LinearLayout>
